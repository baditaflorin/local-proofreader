#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
first_line="$(head -n 1 "$message_file")"

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ops|data|security)(\([a-z0-9._-]+\))?: .+'; then
  printf '%s\n' "Commit message must use Conventional Commits: $first_line"
  exit 1
fi
