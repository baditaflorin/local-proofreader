{
  "manifest_version": 3,
  "name": "Local Proofreader",
  "version": "0.1.0",
  "description": "Inline local grammar and style checks for editable fields.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Local Proofreader"
  }
}
